# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env
.env.local
.env.*.local

# ML artifacts — model binaries are rebuilt at image build time, not committed.
# metrics.json / MODEL_CARD.md ARE committed as validation proof for the tender.
ml/artifacts/model.json
ml/artifacts/meta.json
ml/artifacts/*.pkl
ml/artifacts/*.ubj

# OS / editor
.DS_Store
.idea/
.vscode/

# Data dumps
*.osm.pbf
data/*.csv

# Uploaded operational-card files
api/uploads/

# Real ДЧС source documents with PII (phones, names) — never publish.
# Only derived, sanitized files (*.md, *.json) are tracked in docs/docs_tg/.
docs/docs_tg/*.pdf
docs/docs_tg/*.doc
docs/docs_tg/*.docx
docs/docs_tg/*.vsd

# Те же исходники лежат копиями в docs/ — их тоже не публикуем.
# Исключение: собственная презентация FireWatch (ПДн не содержит).
docs/*.doc
docs/*.docx
docs/*.vsd
docs/*.pdf
!docs/FireWatch — Презентация для ДЧС РК.pdf

# Материалы акселерационных программ (расшифровки воркшопов, презентации, чаты):
# закрыты NDA с Astana Hub (№646 от 13.08.2026) и содержат имена и проекты других
# участников. Репозиторий публичный — держим локально, но не коммитим.
docs/garage/

# Юридические/личные документы в корне репо (договоры, заявки, сканы) —
# содержат ПДн (ИИН, адрес, подписи). Репозиторий публичный: не коммитить.
/*.pdf
/*.doc
/*.docx
/*.jpg
/*.jpeg
/*.png

# CustDev-материалы: заметки интервью содержат имена, должности, телефоны и
# внутренние сведения об объектах респондентов. Репозиторий публичный — локально.
docs/custdev/
