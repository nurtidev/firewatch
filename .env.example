# ─── Database (PostGIS) ───────────────────────────────────────────────
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=firewatch
POSTGRES_DB=firewatch
# Used by api/ml. In Railway set this to a reference to the PostGIS service.
DATABASE_URL=postgresql+psycopg://firewatch:firewatch@db:5432/firewatch

# ─── Claude (Anthropic) ───────────────────────────────────────────────
# Modules 03 (card extraction) and 06 (chat analyst)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Internal service URLs ────────────────────────────────────────────
ML_URL=http://ml:8000
# Public Overpass mirror (OSM building import). Replace with self-hosted later.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ─── Дорожная маршрутизация (зоны прибытия) ───────────────────────────
# Пусто — зоны считаются прямолинейным буфером и помечаются approximate.
# Как поднять роутер и почему это не «просто точнее»: ops/osrm/README.md.
#   ./ops/osrm/prepare.sh && docker compose --profile routing up -d osrm
# FW_ROUTING_URL=http://osrm:5000
#
# Поправка на дорожную обстановку: OSRM считает по свободному потоку.
# Калибруется по своим выездам — GET /infra/routing/calibration.
# FW_ROUTING_TIME_FACTOR=1.0

# ─── Соединения с базой и кэш агрегатов (api/app/db.py, api/app/cache.py) ───
# На один процесс api: запросы ≤ POOL_SIZE + MAX_OVERFLOW, аудит ≤ AUDIT_POOL_MAX.
# Сумма по api/ml/cron/сидам должна помещаться в SHOW max_connections базы.
# FW_DB_POOL_SIZE=5
# FW_DB_MAX_OVERFLOW=10
# FW_DB_POOL_TIMEOUT_SEC=10        # дольше ждать соединение — 503 с Retry-After
# FW_DB_AUDIT_POOL_MAX=3
# FW_DB_HEAVY_STATEMENT_TIMEOUT_MS=8000    # /city/*, слепые зоны, /buildings?bbox — держать < POOL_TIMEOUT_SEC*1000
# FW_READ_CACHE_TTL_SEC=60         # /city/*, /infra/coverage, /infra/blind-zones; 0 — выкл.

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Frontend ─────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8001
